# ============================================================================
# VENU — пример окружения. Скопируй в .env: cp .env.example .env
# .env в .gitignore. Здесь только пример, без реальных секретов.
# ============================================================================

NODE_ENV=development

# ---------------------------------------------------------------- server ----
# Порт ВНУТРИ контейнера. На хосте сервер доступен как localhost:4001
# (4000 занят BITO) — см. проброс портов в docker-compose.yml.
PORT=4000

# Хост Mongo — "mongo": так же он прописан в конфиге replica set (docker/mongo/rs-init.js).
# Драйвер после connect читает конфиг rs и обращается к участникам по ИХ именам,
# поэтому имя должно резолвиться там, откуда подключаешься.
MONGODB_URI=mongodb://mongo:27017/venu?replicaSet=rs0

# С ХОСТ-машины (mongosh, локальный запуск тестов вне контейнера) имя "mongo"
# не резолвится — нужен directConnection, он выключает discovery участников:
#   mongodb://127.0.0.1:27018/venu?directConnection=true
# Порт 27018, а не 27017: 27017 на хосте занят BITO. В compose-сети — 27017.
# Внимание: с directConnection транзакции работают, но это обход, а не норма.

CORS_ORIGIN=http://localhost:3000

# --------------------------------------- появятся на своих этапах ----------
# JWT_ACCESS_SECRET=       (Этап 2)
# JWT_REFRESH_SECRET=      (Этап 2)
# UPLOAD_DIR=/app/uploads  (Этап 4)
# STRIPE_SECRET_KEY=       (Этап 8)
# STRIPE_WEBHOOK_SECRET=   (Этап 8 — у stripe CLI он СВОЙ, не тот, что в дашборде)

# ------------------------------------------------------------------- web ----
# Браузер ходит относительным путём /api — его переписывает rewrite Next'а,
# поэтому публичного (NEXT_PUBLIC_*) базового URL быть НЕ должно: один origin
# для браузера = httpOnly refresh-кука работает без возни с CORS и SameSite.
#
# Серверным компонентам относительные URL недоступны (нет origin'а), им нужен
# абсолютный адрес того же бэкенда — обращение из Node, а не из браузера:
SERVER_API_URL=http://localhost:4001
